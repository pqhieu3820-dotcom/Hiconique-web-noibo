# HICONIQUE Internal Hub — environment template
# Copy this file to .env and fill in real values.

NODE_ENV=production
PORT=3000

# Google Sheets integration (task management).
# Each is the published CSV URL of a Sheet tab. Leave blank to disable.
SHEET_PROJECTS_URL=
SHEET_TASKS_URL=
SHEET_ATTENDANCE_URL=

# Notion public pages — links embedded in the wiki section.
NOTION_WIKI_DESIGN_GUIDELINES=
NOTION_WIKI_SOP=
NOTION_WIKI_HR_HANDBOOK=
NOTION_WIKI_BRAND_GUIDELINES=
NOTION_WIKI_TECHNICAL_SPC=
NOTION_WIKI_LEGAL_DOCS=
NOTION_WIKI_COMPANY_POLICY=
NOTION_WIKI_PAYROLL_2026=

# Team directory — JSON or sheet URL.
TEAM_DATA_URL=
